# ==============================================================================
# Configuración de Base de Datos Neon PostgreSQL (Vercel & Local)
# Proyecto Neon: https://console.neon.tech/app/org-shiny-feather-88417736/projects
# ==============================================================================
# En Vercel: Ve a Settings -> Environment Variables y agrega POSTGRES_URL
# O en Neon: Integrations -> Vercel para conectarlo en 1 clic.
# Localmente: Renombra o copia este archivo a .env con tu connection string real:

POSTGRES_URL="postgresql://neondb_owner:TU_PASSWORD@ep-tu-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://neondb_owner:TU_PASSWORD@ep-tu-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require"
