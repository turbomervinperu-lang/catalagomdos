# ==============================================================================
# Configuración de Base de Datos Neon PostgreSQL (Vercel & Local)
# ==============================================================================
POSTGRES_URL="postgresql://neondb_owner:TU_PASSWORD@ep-tu-endpoint.us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://neondb_owner:TU_PASSWORD@ep-tu-endpoint.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# Almacenamiento de Imágenes: Cloudflare R2 (Object Storage S3-compatible)
# ==============================================================================
# En Vercel: Settings -> Environment Variables
R2_ACCOUNT_ID="tu_account_id_de_cloudflare"
R2_ACCESS_KEY_ID="tu_access_key_id"
R2_SECRET_ACCESS_KEY="tu_secret_access_key"
R2_BUCKET_NAME="catalago-mdos"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
