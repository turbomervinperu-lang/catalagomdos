# ==============================================================================
# Configuración de Base de Datos Neon PostgreSQL (Vercel)
# Base de Datos: neon-green-ladder
# ==============================================================================
# Al conectar Neon en Vercel, estas variables se inyectan automáticamente en Producción y Preview.
# Si deseas probar la base de datos localmente, puedes duplicar este archivo como .env
# y pegar tu Connection String de Neon (obtenido de Vercel Storage -> neon-green-ladder).

POSTGRES_URL="postgres://usuario:password@ep-green-ladder.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgres://usuario:password@ep-green-ladder.us-east-2.aws.neon.tech/neondb?sslmode=require"
